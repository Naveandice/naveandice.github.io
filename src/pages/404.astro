---
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "404 Not Found";
const description = "Why did you think something like that would exist?";
---

<BaseLayout pageTitle={title} pageDescription={description}>
  <h2>{title}</h2>
  <p>{description}</p>
  <p>
    <a href="/">Go home</a>
  </p>
</BaseLayout>

<script>
  const fishtrap = document.createElement("p");
  fishtrap.innerHTML = `Also, it's <a href="/fishstrap/">/fishstrap/</a>, not /fishtrap/. Stupid.`;
  /^\/fishtrap\/?$/.test(window.location.pathname) &&
    document.getElementsByTagName("main")[0].appendChild(fishtrap);
</script>
